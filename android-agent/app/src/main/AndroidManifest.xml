<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking. The agent talks to the backend over LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service permissions. v0.5.0+ both HeartbeatService and
         ScreenCaptureService use DATA_SYNC (screen capture is now driven
         by AccessibilityService.takeScreenshot rather than MediaProjection,
         so the MEDIA_PROJECTION foreground type is no longer needed). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Survive device reboots. BootReceiver listens for BOOT_COMPLETED and
         starts HeartbeatService if a deviceId is saved locally. Standard
         Android feature, no device-owner privileges required. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required on Android 11+ for CommandExecutor.collectUserInstalledPackages
         to enumerate installed apps in FETCH_DIAGNOSTICS. Without this, the
         package-visibility filter in API 30+ would only return apps we have
         a queries declaration for, which is not useful for "tell me what's
         actually installed on this tablet". We are sideloaded (no Play
         distribution) so Play's restrictions on QUERY_ALL_PACKAGES do not
         apply to us. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                     tools:ignore="QueryAllPackagesPermission" />

    <!-- v0.7.0+: in-app updater. Required so the notification posted by
         AgentUpdater can open Android's Package Installer for the
         downloaded APK. User has to approve "install from this source"
         the first time; Android remembers thereafter. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.NewksMdmAgent"
        android:supportsRtl="true"
        android:allowBackup="false"
        tools:targetApi="35"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic is enabled because for MVP testing the backend
          runs over HTTP on the LAN. Before any real deployment switch to
          HTTPS and tighten this via a network_security_config.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Foreground service that keeps the WebSocket loop alive when the UI
          is closed. dataSync is the closest matching subtype for what this
          service does (background heartbeat + command exchange).
        -->
        <service
            android:name=".HeartbeatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Foreground service that runs the per-session screen-capture loop.
          In v0.5.0+ this is a thin wrapper around
          AgentAccessibilityService.takeScreenshot. No MediaProjection,
          no per-session consent dialog. Starts/stops with each session.
        -->
        <service
            android:name=".ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Accessibility service used solely to dispatch input gestures
          (taps + swipes + global keys) during an active remote-control
          session. Must be manually enabled by the user in
          Settings -> Accessibility -> Newk's MDM Agent.
        -->
        <service
            android:name=".AgentAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Boot receiver. Restarts HeartbeatService on device boot so the
          tablet reconnects to the portal without anyone opening the app
          first. Exported because BOOT_COMPLETED is delivered by the system,
          not from our own code.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          v0.7.0+ FileProvider: used by AgentUpdater to share the downloaded
          APK file from our cacheDir with Android's Package Installer.
          Granted per-Intent via FLAG_GRANT_READ_URI_PERMISSION; not
          exported as a general content provider.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
