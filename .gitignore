# ============================================================================
# Newk's MDM — repository ignores
# ============================================================================

# ----------------------------------------------------------------------------
# Production secrets — NEVER commit these. Real values live in the Cloudways
# VM's local .env (outside this repo). Use backend/.env.example as the
# template when bootstrapping a new environment.
# ----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.development
backend/.env
backend/.env.local
# Always keep the example file though — it documents the required keys.
!backend/.env.example

# ----------------------------------------------------------------------------
# Node deps and build outputs (regenerated by `npm ci && npm run build`)
# ----------------------------------------------------------------------------
node_modules/
backend/dist/
frontend/dist/

# Vite / TypeScript caches
.vite/
*.tsbuildinfo

# ----------------------------------------------------------------------------
# Android Studio / Gradle
# Keep source + build.gradle + AndroidManifest + resources.
# Exclude generated build dirs and per-machine IDE state.
# ----------------------------------------------------------------------------
android-agent/.gradle/
android-agent/.idea/
android-agent/local.properties
android-agent/app/build/
android-agent/build/

# The signed APK at frontend/public/agent.apk IS committed -- it's how
# tablets receive the binary at sideload time. ~10 MB per release; manageable
# for our cadence. If repo size becomes a problem later, migrate to git-lfs.

# ----------------------------------------------------------------------------
# Editor / OS noise
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ----------------------------------------------------------------------------
# Logs and runtime state
# ----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
.pm2/

# ----------------------------------------------------------------------------
# Local Docker volumes (only present in dev)
# ----------------------------------------------------------------------------
postgres-data/
