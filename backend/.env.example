# Copy this file to .env and fill in real values. .env is gitignored.
# In production (Cloudways), prefer setting these via the platform's
# Environment Variables panel instead of an on-disk .env -- they take
# precedence and survive deploys.

# 'development' (default) or 'production'. Production binds to 127.0.0.1
# only (assumes nginx in front), serves the built React frontend from this
# same process, and disables wildcard CORS.
NODE_ENV=development

# PostgreSQL connection. Dev default matches docker-compose.yml on host
# port 5433 (5432 collides with the native Postgres install on Kim's laptop).
# Production: point at the production Postgres -- localhost for an
# on-VM install, or a fully-qualified hostname for a managed DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/remote_mdm

# Backend HTTP + WebSocket listen port. Behind nginx in production.
PORT=4000

# Signs all auth tokens. Use a long random string. Rotate before any real deploy.
JWT_SECRET=change_me_to_a_long_random_string

# Shared secret a device must present to enroll. Rotate per environment / per store rollout.
ENROLLMENT_SECRET=change_me_per_environment

# Comma-separated list of origins the admin frontend may call from.
# Dev: Vite serves the frontend on 5173 separately.
# Prod: leave UNSET -- the backend serves the frontend from the same origin
#       so CORS is moot. Set this only if you ever split frontend and
#       backend onto different domains.
CORS_ORIGINS=http://localhost:5173

# First-admin bootstrap. On startup the backend creates a user with this
# username + password IF AND ONLY IF the users table has no admin row yet.
# After your first successful login, REMOVE these two lines from your .env
# (or at minimum rotate the password) so plaintext creds don't sit on disk.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_after_first_login
